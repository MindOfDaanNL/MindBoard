{
  "name": "mindboard",
  "version": "2.0.0",
  "description": "MindBoard — uitgebreid projectbeheer met accounts, rollen, organisaties, projecten en kanban-borden",
  "main": "server.js",
  "bin": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node src/seed.js",
    "db:init": "node scripts/init-db.js",
    "exe": "node scripts/pack-exe.js",
    "icons": "node scripts/gen-icons.js",
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "kanban",
    "projects",
    "boards",
    "tasks",
    "mindboard",
    "express",
    "mariadb"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mariadb": "^3.3.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^5.11.5",
    "supertest": "^7.2.2"
  },
  "pkg": {
    "assets": [
      "public/**/*",
      "sql/**/*",
      "src/**/*"
    ],
    "scripts": [
      "server.js",
      "src/**/*.js"
    ]
  }
}
